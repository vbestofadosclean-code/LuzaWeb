# Configuração privada do backend LuzaWeb. Nunca coloques credenciais reais no repositório.
# Esta base guarda contas, projetos, ficheiros, metadados e estado do LuzaWeb.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate once (e.g. openssl rand -base64 48) and keep the same value across deployments.
JWT_SECRET=replace-with-a-long-random-secret
# Chave obrigatória e independente para cifrar credenciais guardadas (pelo menos 32 bytes).
# Não pode ser igual a JWT_SECRET; não a alteres sem executar a rotação.
SECRET_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-bytes
# Só durante rotação/migração, para ler valores antigos com a chave anterior (incluindo JWT_SECRET usado historicamente). O código não usa JWT_SECRET automaticamente para decifrar. Remove após validar.
# LEGACY_SECRET_ENCRYPTION_KEY=previous-encryption-key-at-least-32-bytes
NODE_ENV=production
# Chave privada da API Neon, usada apenas pelo servidor para criar uma base real por projecto.
# Obtém uma chave na conta Neon e configura-a também nos Environment variables do Netlify.
NEON_API_KEY=replace-with-a-real-neon-api-key
# Opcional, quando a chave da API exige indicar a organização.
# NEON_ORG_ID=your-neon-organization-id
# Leave unset by default so TLS certificates are validated. Change only if you understand the security impact.
# DB_SSL_REJECT_UNAUTHORIZED=false

# Limites de desempenho; em Netlify o pool principal fica em 1 por instância por padrão.
# PG_POOL_MAX=1
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_STATEMENT_TIMEOUT_MS=15000
# Os arranques aguardam no máximo 15s pelo lock de migração e limitam o bloco de migração a 120s.
# PG_MIGRATION_LOCK_TIMEOUT_MS=15000
# PG_MIGRATION_STATEMENT_TIMEOUT_MS=120000
# PG_PROJECT_POOL_CACHE_MAX=20
# PG_POOL_WAITING_LIMIT=10
# Regista/alerta pedidos cuja duração ultrapasse este tempo (ms).
# SLOW_REQUEST_ALERT_MS=2000
# Limite de ligações à espera antes de readiness sinalizar saturação.
# Se estiveres atrás de um proxy self-hosted, configura explicitamente os saltos de proxy confiáveis.
# TRUST_PROXY_HOPS=0
# Para teste de carga controlado: LOAD_URL=https://teu-site.netlify.app, LOAD_CONCURRENCY=10, LOAD_REQUESTS=100

# Retenção automática do histórico por projeto (snapshots mais recentes e publicações).
# Valores padrão: 30 commits e 10 deployments; limites aceites: commits 5-200, deployments 3-100.
# COMMIT_RETENTION_PER_PROJECT=30
# DEPLOYMENT_RETENTION_PER_PROJECT=10
# Para limpar também projetos antigos sem novas publicações, faz backup e executa: HISTORY_CLEANUP_CONFIRM=YES npm run history:cleanup

# Opcional: webhook HTTPS para alertas operacionais (HTTP 5xx e base de dados indisponível).
# ALERT_WEBHOOK_URL=https://teu-servico-de-alertas.example/webhook
# ALERT_COOLDOWN_MS=300000
# Para monitorização externa via GitHub Actions, configura o secret LUZAWEB_HEALTHCHECK_URL
# com https://teu-site.netlify.app/api/health/ready.

# Limitador centralizado da API pública (armazenado na base interna partilhada).
# Limites por IP, chave e projeto, separados para chaves públicas e privadas; partilhados por todas as instâncias.
# PUBLIC_API_RATE_LIMIT_PER_IP=120
# PUBLIC_API_RATE_LIMIT_PER_KEY=600
# PUBLIC_API_RATE_LIMIT_PER_PROJECT=1200
# PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000
# PRIVATE_API_RATE_LIMIT_PER_IP=300
# PRIVATE_API_RATE_LIMIT_PER_KEY=3000
# PRIVATE_API_RATE_LIMIT_PER_PROJECT=6000
# PRIVATE_API_RATE_LIMIT_WINDOW_MS=60000

# Segurança do teste de ligações PostgreSQL externas.
# Por defeito, só são permitidas as portas PostgreSQL comuns 5432 e 6432.
# Para fornecedores com porta customizada, define uma lista explícita, por exemplo 5432,6432,15432.
# POSTGRES_ALLOWED_PORTS=5432,6432
# Limites partilhados por projeto/IP; requer a tabela api_rate_limits da base interna.
# POSTGRES_CONNECTION_TESTS_PER_IP=5
# POSTGRES_CONNECTION_TESTS_PER_PROJECT=20
# POSTGRES_CONNECTION_TEST_WINDOW_MS=600000


# Limites de recursos para evitar abuso e criação acidental de recursos pagos.
# Projectos contam também os que estão na lixeira; elimina definitivamente dados antigos antes de criar mais.
PROJECTS_PER_USER_LIMIT=10
PROJECTS_GLOBAL_LIMIT=1000
PROJECT_CREATIONS_PER_USER_PER_HOUR=5
PROJECT_CREATIONS_PER_IP_PER_HOUR=10

# Bases Neon criadas e geridas pelo LuzaWeb.
NEON_DATABASES_PER_USER_LIMIT=3
NEON_DATABASES_GLOBAL_LIMIT=80
NEON_DATABASE_CREATIONS_PER_USER_PER_HOUR=3
NEON_DATABASE_CREATIONS_PER_IP_PER_HOUR=5
RESOURCE_CREATION_WINDOW_MS=3600000
# Limite conservador total da conta Neon (inclui projectos já existentes fora do LuzaWeb).
# Ajusta conforme o plano e a política da conta. O fornecedor continua a aplicar os próprios limites.
NEON_ACCOUNT_PROJECT_LIMIT=90


# Backup completo cifrado (execute fora da função serverless; nunca guarde valores reais aqui).
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=30
# BACKUP_COMMAND_TIMEOUT_MS=1800000
# BACKUP_ENCRYPTION_PASSPHRASE=generate-a-separate-random-64-character-secret
# O workflow GitHub Actions usa os segredos LUZAWEB_DATABASE_URL,
# LUZAWEB_SECRET_ENCRYPTION_KEY, LUZAWEB_BACKUP_ENCRYPTION_PASSPHRASE e,
# apenas durante uma migração de chave, LUZAWEB_LEGACY_SECRET_ENCRYPTION_KEY.
